{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/chatgpt?endpoint=oauth-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/chatgpt?endpoint=oauth-resource"
    },
    {
      "source": "/api/chatgpt-create-service",
      "destination": "/api/chatgpt?endpoint=create-service"
    },
    {
      "source": "/api/chatgpt-list-services",
      "destination": "/api/chatgpt?endpoint=list-services"
    },
    {
      "source": "/api/chatgpt-mcp",
      "destination": "/api/chatgpt?endpoint=mcp"
    },
    {
      "source": "/api/chatgpt-oauth-authorize",
      "destination": "/api/chatgpt?endpoint=oauth-authorize"
    },
    {
      "source": "/api/chatgpt-oauth-jwks",
      "destination": "/api/chatgpt?endpoint=oauth-jwks"
    },
    {
      "source": "/api/chatgpt-oauth-metadata",
      "destination": "/api/chatgpt?endpoint=oauth-metadata"
    },
    {
      "source": "/api/chatgpt-oauth-resource",
      "destination": "/api/chatgpt?endpoint=oauth-resource"
    },
    {
      "source": "/api/chatgpt-oauth-token",
      "destination": "/api/chatgpt?endpoint=oauth-token"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://sedifex-web.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://sedifex-web.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/api/google-business/locations",
      "destination": "https://us-central1-sedifex-web.cloudfunctions.net/googleBusinessLocations"
    },
    {
      "source": "/((?!api/|assets/|__/auth/|__/firebase/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
